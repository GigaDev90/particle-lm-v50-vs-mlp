  "definitions": {
    "raw_gate": "w_ai = kernel_gain * max(1 - d_ai_squared/r_ai_squared, 0)^2; q_a and resident p_ai are normalized and d_ai_squared uses their actual norms. A nonpositive support term produces an exactly zero raw gate.",
    "normalized_gate": "kappa_ai = w_ai / sqrt(mean_over_109_residents(w_aj^2) + 1/(109*4)); normalizing does not turn zero gates into positive gates.",
    "active_fraction": "Native float32 mean of (raw_gate > 0), across 256 positions, 4 spaces and 109 residents; stored unchanged.",
    "active_gate_count": "Exact integer count recovered as mean_active_residents_per_head * (256*4). Independently, rounding native active_fraction * 111616 yields the same integer for every row. The exact count ratio and native float32 reduction agree within one float32 ULP after rounding.",
    "exact_zero_gate_count": "111616 - active_gate_count. This counts zero token-space-resident gate entries, not globally unused residents.",
    "exact_zero_gate_fraction": "exact_zero_gate_count / 111616; a derived double-precision ratio. Tiny differences from 1-active_fraction reflect native float32 reduction and rounding.",
    "empty_query_fraction": "Fraction of the 256 positions with no positive raw gate among any of the 436 residents in that block.",
    "empty_head_fraction": "Fraction of the 256*4 position-space pairs with no positive raw gate among that space's 109 residents.",
    "effective_neighbors": "Mean over 256 positions of (sum_over_all_436_residents(w))^2 / max(sum_over_all_436_residents(w^2), 1e-12), using raw nonnegative gates. A zero vector gives zero. This is a strength-concentration measure, not a nonzero count.",
    "mean_effective_neighbors_per_head": "Mean over 256*4 position-space pairs of (sum_over_109(w))^2 / max(sum_over_109(w^2), 1e-12). It is not effective_neighbors divided by four.",
    "mean_active_residents_per_head": "Mean count of strictly positive raw gates over 256*4 position-space pairs; maximum 109.",
    "gate_rms": "RMS of normalized resident gates kappa across the same 256*436 entries.",
    "mean_gate_cosine": "Mean cosine between distinct token positions' 436-dimensional normalized-gate patterns. Each pattern is L2-normalized with epsilon 1e-12; all 256*255 ordered pairs are included and zero patterns contribute zero. This is not a query-resident spatial cosine.",
    "query_rms": "RMS of h = particle_norm(residual after attention), before the learned query projection and per-space query normalization. This is not the norm of routing q.",
    "force_rms": "Field RMS: RMS of the complete learned particle-field write before residual addition over the same 256 positions and 512 output coordinates. Native trajectory_displacement_rms is identical and omitted as a duplicate.",
    "radius_squared": "Mean of the 436 learned squared support radii in the block; not an average query-resident distance.",
    "radius_squared_min": "Minimum of the block's 436 learned squared support radii.",
    "radius_squared_max": "Maximum of the block's 436 learned squared support radii.",
    "equal_block_mean": "Arithmetic mean of each recorded scalar across eight equal-size blocks. Mean force_rms and query_rms are means of block RMS values, not pooled RMS values."
  },
